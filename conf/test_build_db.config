/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for a minimal test of the database build (--new_mgnify_db)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Uses the tiny catalogue in tests/mgnify_catalogue and the tiny eggNOG database in
    tests/eggnog_db (see tests/mgnify_catalogue/make_fixture.py).

    Use as follows:
        nextflow run ebi-metagenomics/biosiftr -profile test_build_db,<docker/singularity> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

process {
    errorStrategy = 'terminate'
    maxRetries = 0
    resourceLimits = [
        cpus: 2,
        memory: 6.GB,
        time: 2.h
    ]
}

params {
    new_mgnify_db  = true
    catalogue_path = "${projectDir}/tests/mgnify_catalogue/test-host/v1.0/ftp"
    eggnog_db_dir  = "${projectDir}/tests/eggnog_db"
    // Pfam-A.hmm.dat.gz comes from the DRAM databases folder
    reference_dbs  = "${projectDir}/tests/reference_dbs/"
}
